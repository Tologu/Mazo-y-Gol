# Copia este archivo a .env.local y rellena los valores desde:
# Supabase Dashboard → Project Settings → API

# URL del proyecto (pública, va al cliente)
NEXT_PUBLIC_SUPABASE_URL=

# Clave anon (pública, protegida por RLS — va al cliente)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública de la app (emails de auth y callbacks; evita 0.0.0.0 en local)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clave service_role (SECRETO — solo servidor/API Routes, NUNCA en el cliente)
SUPABASE_SERVICE_ROLE_KEY=

# Para subir migraciones con la CLI (opcional)
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_PROJECT_REF=
