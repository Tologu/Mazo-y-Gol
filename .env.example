# Copia este archivo a .env.local y rellena los valores desde:
# Supabase Dashboard → Project Settings → API

# URL del proyecto (pública, va al cliente)
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROJECT_REF.supabase.co

# Clave anon (pública, protegida por RLS — va al cliente)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Clave service_role (SECRETO — solo servidor/API Routes, NUNCA en el cliente)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Para subir migraciones con la CLI (opcional)
# SUPABASE_ACCESS_TOKEN=sbp_...   → Account → Access Tokens
# SUPABASE_PROJECT_REF=tu_project_ref   → URL del dashboard: /project/ESTE_ID
